%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: LocalizationTable_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: fa88b033994461f419692bbaa512fc25, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 45166931968
    m_Localized: Ce n'est pas grave. Tout le monde peut faire des erreurs.
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234827
    m_Localized: "F\xE9licitations ! Vous avez termin\xE9 tous les exercices ! Passons
      maintenant au chapitre suivant pour devenir le roi de la marche en toute s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234826
    m_Localized: "F\xE9licitations pour avoir obtenu le titre de Roi des pi\xE9tons
      en s\xE9curit\xE9 dans le chapitre Crossing the Alley\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234825
    m_Localized: "F\xE9licitations pour avoir obtenu le titre de Roi des pi\xE9tons
      en s\xE9curit\xE9 dans le chapitre Traverser le passage pour pi\xE9tons\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234824
    m_Localized: "Tu as travaill\xE9 dur ! C'est super que tu sois arriv\xE9 jusqu'ici
      !\nJe te donnerai un certificat de s\xE9curit\xE9 pi\xE9tonne pour avoir termin\xE9
      tous les jeux !\nTu feras encore mieux la prochaine fois !\n\nJe t'encouragerai
      toujours !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234823
    m_Localized: "Vous avez travaill\xE9 dur\_!\nVous avez r\xE9ussi la formation
      de marche s\xE9curitaire et avez re\xE7u un certificat\_!\nEn vous entra\xEEnant
      un peu plus, vous aussi, vous pourrez pr\xE9tendre \xE0 la m\xE9daille d'or\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234822
    m_Localized: "C'\xE9tait vraiment g\xE9nial\_!\nUn certificat de r\xE9ussite
      est remis au pi\xE9ton mod\xE8le qui a parfaitement suivi la formation de marche
      en toute s\xE9curit\xE9\_!\nJ'esp\xE8re que vous pourrez marcher en toute s\xE9curit\xE9
      \xE0 l'avenir.\n\nF\xE9licitations du fond du c\u0153ur\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234821
    m_Localized: "3...2...1...d\xE9part !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234820
    m_Localized: "C'est un jeu o\xF9 vous devez observer attentivement les gens autour
      de vous\_!\nTrouvez les personnes qui marchent dangereusement et s\xE9lectionnez-les
      avec la manette\_!\nSi vous les trouvez correctement, votre score augmentera,
      et si vous vous trompez, il pourrait baisser\_!\nDevinez le plus de personnes
      possible dans le temps imparti\_! Pr\xEAts\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234819
    m_Localized: "Vous \xEAtes d\xE9sormais un expert des angles morts\_!\n\nAllons
      donc \xE0 l'endroit suivant\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234818
    m_Localized: "Maintenant, v\xE9rifions o\xF9 sont nos amis encore bien cach\xE9s.\nSi
      la voiture avait boug\xE9 pendant que nos amis se cachaient comme \xE7a, \xE7a
      aurait \xE9t\xE9 vraiment dangereux.\nVous savez maintenant \xE0 quel point
      les angles morts sont dangereux, n'est-ce pas\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234817
    m_Localized: "Bien jou\xE9 ! Voyons voir si tu as bien trouv\xE9 tes amis.\nOh~
      Tu les as trouv\xE9s ?! Tu as fait du bon travail !\nMais\u2026 cet ami s'est
      vraiment bien cach\xE9, non ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234816
    m_Localized: "Est-il difficile de voir l'angle mort\_? Voyons-le par vous-m\xEAme
      avec un jeu simple.\nDes amis malicieux se cacheront autour de la voiture\_!\nIl
      faut les rep\xE9rer et les trouver\_!\nCombien parviendrez-vous \xE0 en trouver
      dans le temps imparti\_?!\nAlors, pr\xEAt\_?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040540
    m_Localized: "Les angles morts sont des espaces invisibles pour le conducteur.\nIls
      ne sont visibles ni \xE0 travers les vitres ni les r\xE9troviseurs\u2026\n\nC'est
      vraiment dangereux si votre ami s'y trouve.\nAlors, \xE0 partir de maintenant,
      vous allez le v\xE9rifier de vos propres yeux\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040539
    m_Localized: "Cette fois, je vous ai pr\xE9par\xE9 une exp\xE9rience vraiment
      sp\xE9ciale\_!\nIl existe ce qu'on appelle un angle mort dans une voiture\_!\nVoyons
      par vous-m\xEAme \xE0 quel point il est difficile de voir\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040538
    m_Localized: "Mission de marche s\xE9curis\xE9e dans la ruelle termin\xE9e\_!
      Vous pouvez maintenant traverser la ruelle tout seul, n'est-ce pas\_? Bien,
      on passe \xE0 la le\xE7on suivante\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040537
    m_Localized: Bravo ! Tu es le meilleur !
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040536
    m_Localized: Regardez autour de vous !
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040535
    m_Localized: "Bon alors, passons \xE0 l'endroit suivant !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040534
    m_Localized: "Vous \xEAtes d\xE9sormais un expert des angles morts !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040533
    m_Localized: "Vous savez maintenant \xE0 quel point les angles morts peuvent
      \xEAtre dangereux, n\u2019est-ce pas ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040532
    m_Localized: "Si la voiture avait boug\xE9 pendant que mes amis se cachaient
      comme \xE7a, cela aurait \xE9t\xE9 vraiment dangereux."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040531
    m_Localized: "Alors maintenant, v\xE9rifions o\xF9 sont nos amis qui se sont
      bien cach\xE9s jusqu'\xE0 pr\xE9sent ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040530
    m_Localized: "Oh~ Tu l'as trouv\xE9 ?! Tu as fait du bon travail ! Mais\u2026
      ce type se cachait vraiment bien, non ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040529
    m_Localized: "Bravo ! Voyons si tu as r\xE9ussi \xE0 trouver tes amis."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040528
    m_Localized: "Alors, \xEAtes-vous pr\xEAt ?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040527
    m_Localized: "Combien de personnes pouvez-vous trouver dans le temps imparti\_?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040526
    m_Localized: "Des amis malicieux se cacheront autour de la voiture\_! Il suffit
      de les rep\xE9rer et de les trouver\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040525
    m_Localized: "Que diriez-vous de d\xE9couvrir par vous-m\xEAme \xE0 quel point
      les angles morts sont mal per\xE7us avec un jeu simple ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040524
    m_Localized: "Alors \xE0 partir de maintenant, vous le verrez de vos propres
      yeux !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040523
    m_Localized: "Je ne vois pas tr\xE8s bien \xE0 travers la fen\xEAtre ou le miroir...
      C'est vraiment dangereux si mon ami est l\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040522
    m_Localized: Les angles morts sont des zones qui ne sont pas visibles pour le
      conducteur.
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040521
    m_Localized: "Il y a ce qu'on appelle un angle mort en voiture\_! Voyons par
      vous-m\xEAme \xE0 quel point il est difficile de voir\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040520
    m_Localized: "Cette fois-ci, nous vous avons pr\xE9par\xE9 une exp\xE9rience
      tr\xE8s sp\xE9ciale !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040519
    m_Localized: Levez la main et traversez la rue
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040518
    m_Localized: "Regardez \xE0 gauche et \xE0 droite avant de traverser"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040517
    m_Localized: "Traversez la rue en toute s\xE9curit\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040516
    m_Localized: Levez la main et traversez la rue
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040515
    m_Localized: "Regardez \xE0 gauche et \xE0 droite avant de traverser"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040514
    m_Localized: "Tout d\u2019abord, arr\xEAtez."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040513
    m_Localized: "Traversez la rue en toute s\xE9curit\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040512
    m_Localized: Je dois aller retrouver un ami
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846235
    m_Localized: Attendez que le voyant vert s'allume.
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846234
    m_Localized: "C'est s\xFBr derri\xE8re la ligne de s\xE9curit\xE9 jaune."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846233
    m_Localized: Levez la main et traversez la rue.
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846232
    m_Localized: "Levez vos mains bien au-dessus de votre t\xEAte."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846231
    m_Localized: "Regardez les deux c\xF4t\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846230
    m_Localized: "Reprenons la route et essayons \xE0 nouveau !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846229
    m_Localized: "Comment \xE7a va ? Maintenant, tu sais quoi faire, n'est-ce pas
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846228
    m_Localized: "Dans les endroits o\xF9 vous ne pouvez pas voir devant vous, arr\xEAtez-vous
      toujours et v\xE9rifiez d'abord. D'accord ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846227
    m_Localized: "Regardez, ce type n'est pas simplement sorti, il s'est d'abord
      arr\xEAt\xE9 et a regard\xE9 \xE0 gauche et \xE0 droite ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846226
    m_Localized: "Bon, alors, voyons ce qu\u2019il faut faire maintenant ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846225
    m_Localized: "Sur une route o\xF9 vous ne pouvez pas voir devant vous, vous devez
      vous arr\xEAter, v\xE9rifier, puis avancer."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846224
    m_Localized: "Si nous ne pouvons pas nous voir comme nous l'avons fait tout \xE0
      l'heure, nous pourrions avoir de s\xE9rieux probl\xE8mes."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846223
    m_Localized: "H\xE9, ce type\u2026 Il marche sans regarder autour de lui."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846222
    m_Localized: "Donc, si je prends l\u2019habitude de regarder d\u2019abord les
      voitures, m\xEAme si elles ne peuvent pas me voir, je serai beaucoup plus en
      s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846221
    m_Localized: "M\xEAme si vous reconnaissez la voiture, si vous pensez : \xAB
      C\u2019est bon maintenant \xBB et que vous continuez, cela peut \xEAtre plus
      dangereux."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846220
    m_Localized: "Dans des endroits comme celui-ci o\xF9 nous sommes bloqu\xE9s par
      des murs ou des voitures, nous ne pouvons pas voir une voiture arriver \xE0
      l'avance."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846219
    m_Localized: "Alors, avant de sortir dans une ruelle ou dans un endroit hors
      de vue, vous devriez absolument v\xE9rifier une fois de plus."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846218
    m_Localized: "Tout comme maintenant, les voitures peuvent sortir du c\xF4t\xE9
      que vous ne pouvez pas voir."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846217
    m_Localized: "Reprenons la route et essayons \xE0 nouveau !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846216
    m_Localized: "Comment \xE7a va ? Maintenant, tu sais quoi faire, n'est-ce pas
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846215
    m_Localized: "Lorsque vous d\xE9passez un v\xE9hicule en marche, d\xE9placez-vous
      toujours vers une position o\xF9 le conducteur peut vous voir."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846214
    m_Localized: "\xC9coute, ce type, au lieu de se d\xE9placer vers l'arri\xE8re
      de la voiture, pourquoi ne te d\xE9places-tu pas vers une position o\xF9 le
      conducteur peut te voir ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846213
    m_Localized: "Bon, alors, voyons ce qu\u2019il faut faire maintenant ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846212
    m_Localized: C'est pourquoi nous ne devrions jamais nous tenir dans l'angle mort
      du conducteur.
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846211
    m_Localized: "Si la voiture avait continu\xE9 un peu plus loin, on aurait failli
      avoir un accident ! N'est-ce pas incroyablement dangereux ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846210
    m_Localized: "Il y a une voiture qui bloque l'emplacement de mon ami, donc je
      ne peux pas le voir du tout de l'int\xE9rieur."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846209
    m_Localized: "Nous appelons ces endroits des \xAB angles morts \xBB. C\u2019est
      pourquoi nous devons \xEAtre plus prudents dans ces endroits."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846208
    m_Localized: "Il en va de m\xEAme pour les personnes en voiture. Vous pourriez
      ne pas \xEAtre visible non plus."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651936
    m_Localized: "Si vous regardez ici, ne voyez-vous pas le visage de la personne
      \xE0 l'int\xE9rieur de la voiture ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651935
    m_Localized: "Donc, si la voiture commence \xE0 tourner ou \xE0 bouger, cela
      peut \xEAtre tr\xE8s dangereux."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651934
    m_Localized: "En fait, le chauffeur ne vous a peut-\xEAtre pas vu l\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651933
    m_Localized: "D\xE9couvrons ensemble pourquoi c'\xE9tait dangereux !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651932
    m_Localized: "C'est bon ! Vous ne le saviez peut-\xEAtre pas."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651931
    m_Localized: "Regardez ! Si vous faites \xE7a, vous pourrez traverser en toute
      s\xE9curit\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651930
    m_Localized: "Tout d\u2019abord, regardez \xE0 gauche et \xE0 droite\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651929
    m_Localized: "Bon, alors, voyons ce qu\u2019il faut faire maintenant ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651928
    m_Localized: "Waouh ! Je suis vraiment surpris ! Il peut y avoir des voitures
      qui arrivent m\xEAme quand le feu est vert !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651927
    m_Localized: "Regardez, ce type traverse la rue d\xE8s que le feu passe au vert."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651926
    m_Localized: "Vous devez donc d\u2019abord v\xE9rifier si la voiture s\u2019est
      arr\xEAt\xE9e avant de traverser."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651925
    m_Localized: "M\xEAme si le signal change, il se peut qu'une voiture arrive sur
      le c\xF4t\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651924
    m_Localized: "Parfois, les voitures ratent le signal et passent simplement, nous
      devons donc v\xE9rifier d'abord."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651923
    m_Localized: "Avant, d\xE8s que le feu vert s'allumait, on traversait sans rien
      regarder."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651922
    m_Localized: "Reprenons la route et essayons \xE0 nouveau !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651921
    m_Localized: "Comment \xE7a va ? Maintenant, tu sais quoi faire, n'est-ce pas
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651920
    m_Localized: "Ainsi, les personnes en voiture pourront rapidement vous reconna\xEEtre
      et traverser la rue en toute s\xE9curit\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651919
    m_Localized: "Ce type ne l\xE8ve-t-il pas la main quand il traverse ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651918
    m_Localized: "Bon, alors, voyons ce qu\u2019il faut faire maintenant ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651917
    m_Localized: "Si vous ne levez pas la main, le conducteur risque de ne pas vous
      voir et il pourrait \xEAtre difficile de s\u2019arr\xEAter."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651916
    m_Localized: "Regardez, il traverse sans m\xEAme lever la main."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651915
    m_Localized: "Il est donc pr\xE9f\xE9rable que nous levions d\u2019abord la main
      et que nous le leur fassions savoir."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651914
    m_Localized: "Les personnes en voiture ont parfois du mal \xE0 voir devant ou
      sur les c\xF4t\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651913
    m_Localized: Eh bien, il faut faire attention, n'est-ce pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651912
    m_Localized: "Si vous ne levez pas la main, les personnes dans la voiture risquent
      de ne pas vous voir et la voiture risque de passer \xE0 c\xF4t\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651911
    m_Localized: "Tu es parti tout \xE0 l'heure, n'est-ce pas ? Tu n'as m\xEAme pas
      lev\xE9 la main."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651910
    m_Localized: "Voyons pourquoi ce qui vient de se passer \xE9tait dangereux !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651909
    m_Localized: Ce n'est pas grave. Tout le monde peut faire des erreurs.
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651908
    m_Localized: "Reprenons la route et essayons \xE0 nouveau !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651907
    m_Localized: "Comment \xE7a va ? Maintenant, tu sais quoi faire, n'est-ce pas
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651906
    m_Localized: "N'oubliez jamais qu'ob\xE9ir au signal prot\xE8ge votre s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651905
    m_Localized: "Lorsque le feu passe au vert, regardez \xE0 gauche et \xE0 droite,
      levez la main et traversez lentement."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651904
    m_Localized: "Lorsque le feu est rouge, vous devez vous arr\xEAter derri\xE8re
      la ligne de s\xE9curit\xE9 jaune comme ceci."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457628
    m_Localized: "Ok, cette fois je vais vous montrer calmement comment \xEAtre en
      s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457627
    m_Localized: "Ainsi, lorsque vous traversez la rue, vous devez suivre le signal
      et traverser uniquement sur la route d\xE9sign\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457626
    m_Localized: "Mais si nous ne gardons pas cela \xE0 l'esprit, cela devient trop
      dangereux car ni la voiture ni moi ne savons quoi faire."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457625
    m_Localized: "Les feux de circulation et les passages pi\xE9tons sont une promesse
      visant \xE0 aider les voitures \xE0 savoir quand et o\xF9 les gens doivent
      traverser."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457624
    m_Localized: "S\xE9rieusement, cela pourrait conduire \xE0 un accident majeur
      en un instant."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457623
    m_Localized: "Dans des moments comme celui-ci, la voiture ne peut pas vous voir
      et il est presque impossible pour elle de s'arr\xEAter."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457622
    m_Localized: "Vous venez de dire : avez-vous travers\xE9 la rue alors que le
      feu \xE9tait rouge ? Ou \xEAtes-vous entr\xE9 dans la rue alors qu'il n'y avait
      pas de passage pi\xE9ton ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457621
    m_Localized: "Pourquoi as-tu fait quelque chose d'aussi dangereux ? M\xEAme pour
      plaisanter, tu ne devrais jamais faire une chose pareille."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457620
    m_Localized: "C\u2019\xE9tait\u2026 quelque chose que je n\u2019aurais vraiment
      pas d\xFB faire."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457619
    m_Localized: "Reprenons la route et essayons \xE0 nouveau !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457618
    m_Localized: "Comment \xE7a va ? Maintenant, tu sais quoi faire, n'est-ce pas
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457617
    m_Localized: "Je suis s\xFBr que tu peux y arriver. Je crois en toi !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457616
    m_Localized: "C'est tr\xE8s simple ! Quand vous marchez sur la route, allez droit
      au bout sans vous arr\xEAter."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457615
    m_Localized: "Ok, voyons comment proc\xE9der."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457614
    m_Localized: "Si le flux devient ainsi enchev\xEAtr\xE9, cela peut \xEAtre dangereux
      pour les voitures et les pi\xE9tons."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457613
    m_Localized: "Si vous vous arr\xEAtez brusquement comme vous venez de le faire,
      les personnes derri\xE8re vous pourraient \xEAtre surprises et se blesser."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457612
    m_Localized: "Donc, sur la route, la chose la plus s\xFBre \xE0 faire est de
      continuer \xE0 marcher sans s\u2019arr\xEAter."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457611
    m_Localized: "Si le flux s\u2019emm\xEAle de cette fa\xE7on, une situation plus
      dangereuse peut survenir."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457610
    m_Localized: "Si vous vous arr\xEAtez, la voiture et les personnes qui vous suivent
      pourraient \xEAtre confuses et demander : \xAB Hein ? Pourquoi vous \xEAtes-vous
      arr\xEAt\xE9 ? \xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457609
    m_Localized: "La voiture s'est arr\xEAt\xE9e parce qu'elle pensait que tu allais
      continuer \xE0 marcher."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457608
    m_Localized: "La route est trop dangereuse pour rester l\xE0."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457607
    m_Localized: "Si vous vous arr\xEAtez brusquement, l\u2019environnement peut
      devenir chaotique."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457606
    m_Localized: Tout le monde attendait que tu marches
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457605
    m_Localized: "Tout \xE0 l'heure, vous traversiez la rue et vous vous \xEAtes
      soudainement arr\xEAt\xE9 au milieu de la rue ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457604
    m_Localized: "Voyons pourquoi ce qui vient de se passer \xE9tait dangereux !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457603
    m_Localized: Ce n'est pas grave. Tout le monde peut faire des erreurs.
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457602
    m_Localized: "Reprenons la route et essayons \xE0 nouveau !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457601
    m_Localized: "Comment \xE7a va ? Maintenant, tu sais quoi faire, n'est-ce pas
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457600
    m_Localized: "Si vous attendez comme \xE7a et que vous traversez ensuite, vous
      pouvez traverser la route en toute s\xE9curit\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263318
    m_Localized: "Pouvez-vous voir ce type s\u2019arr\xEAter lorsque le feu clignote
      et attendre le prochain signal ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263317
    m_Localized: "Bon, alors, voyons ce qu\u2019il faut faire maintenant ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263316
    m_Localized: "Si vous ne respectez pas les r\xE8gles, ce genre de situation arrivera
      ! Alors, respectez-les ! C'est la seule fa\xE7on d'\xEAtre vraiment en s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263315
    m_Localized: Ahh ! Je le savais !
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263314
    m_Localized: "Regardez, \xE7a clignote en ce moment, mais si vous le traversez..."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263313
    m_Localized: "Si vous traversez \xE0 ce moment-l\xE0, vous risquez de vous retrouver
      arr\xEAt\xE9 au milieu de la route ou une voiture pourrait arriver en trombe."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263312
    m_Localized: "Si le voyant vert clignote, cela signifie qu'il deviendra bient\xF4t
      rouge."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263311
    m_Localized: "\xC0 ce moment-l\xE0, il est trop dangereux de traverser car cela
      signifie que le signal va bient\xF4t changer."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263310
    m_Localized: "Vous avez commenc\xE9 \xE0 traverser lorsque le feu vert a commenc\xE9
      \xE0 clignoter, n'est-ce pas ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263309
    m_Localized: "Voyons pourquoi ce qui vient de se passer \xE9tait dangereux !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263308
    m_Localized: Ce n'est pas grave. Tout le monde peut faire des erreurs.
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263307
    m_Localized: "Reprenons la route et essayons \xE0 nouveau !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263306
    m_Localized: "Comment \xE7a va ? Maintenant, tu sais quoi faire, n'est-ce pas
      ?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263305
    m_Localized: "De cette fa\xE7on, le conducteur peut mieux vous voir, c'est donc
      beaucoup plus s\xFBr !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263304
    m_Localized: "Regardez, ce type attend juste \xE0 l\u2019int\xE9rieur de la ligne
      jaune !"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263303
    m_Localized: "Eh bien, voyons comment \xEAtre en s\xE9curit\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263302
    m_Localized: Une voiture pourrait bien vous percuter si elle arrive !
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263301
    m_Localized: "\xC9coute, si tu vas trop loin comme \xE7a\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263300
    m_Localized: Et si vous avancez trop, vous courez le risque de heurter une voiture.
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263299
    m_Localized: "La raison pour laquelle il y a des lignes de s\xE9curit\xE9 est
      de permettre aux conducteurs de nous voir plus facilement."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263298
    m_Localized: "Cette ligne est un panneau stop. L'ignorer pourrait entra\xEEner
      un grave accident."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263297
    m_Localized: "La raison pour laquelle vos actions \xE9taient dangereuses \xE0
      l\u2019instant \xE9tait que vous aviez franchi la ligne jaune."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263296
    m_Localized: "Voyons ensemble pourquoi ce qui vient de se passer \xE9tait dangereux
      !"
    m_Metadata:
      m_Items: []
