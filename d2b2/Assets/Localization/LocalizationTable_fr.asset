  - m_Id: 28671530807310
    m_Localized: "Param\xE8tres de fonctionnement"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807311
    m_Localized: "Param\xE8tres sonores"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807312
    m_Localized: Aller au principal
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807313
    m_Localized: fermer
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807314
    m_Localized: "\xC9chelle de rendu"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807315
    m_Localized: "Contr\xF4le de la luminosit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807316
    m_Localized: "modicit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807317
    m_Localized: hauteur
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807318
    m_Localized: tristesse
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807319
    m_Localized: "Luminosit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807320
    m_Localized: Options pour les daltoniens
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807321
    m_Localized: "R\xE9initialiser les param\xE8tres"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807322
    m_Localized: "D\xE9sactiver la rotation du contr\xF4leur"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807323
    m_Localized: "Rotation \xE0 angle fixe"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807324
    m_Localized: Rotation en douceur
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807325
    m_Localized: Angle de rotation
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807326
    m_Localized: Vitesse de rotation fluide
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807327
    m_Localized: Lent
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807328
    m_Localized: vitesse
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807329
    m_Localized: Volume complet
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807330
    m_Localized: Volume de la musique de fond
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807331
    m_Localized: Volume du guidage vocal
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807332
    m_Localized: Volume de l'effet sonore
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807333
    m_Localized: Quel est ton nom?
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807334
    m_Localized: Veuillez entrer votre nom.
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807335
    m_Localized: "Les lettres majuscules et minuscules cor\xE9ennes et anglaises
      sont possibles"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807336
    m_Localized: "Pas d'espaces/Pas de consonnes initiales/8 caract\xE8res maximum"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807337
    m_Localized: prudence
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807338
    m_Localized: Surveillance parentale requise
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807339
    m_Localized: "Soyez prudent avec les grands mouvements tels que lever les bras
      ou tourner la t\xEAte."
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807340
    m_Localized: "Arr\xEAtez imm\xE9diatement si vous vous sentez \xE9tourdi."
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807341
    m_Localized: "Souhaitez-vous le d\xE9finir comme surnom ci-dessous ?"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807342
    m_Localized: Dos
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807343
    m_Localized: "Configuration du pseudo termin\xE9e\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807344
    m_Localized: Mon surnom
    m_Metadata:
      m_Items: []
  - m_Id: 913980270129152
    m_Localized: "Nombre d'amis trouv\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266496
    m_Localized: "Nombre d'amis non trouv\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266497
    m_Localized: Correction du daltonisme
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266498
    m_Localized: "D\xE9sactiv\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266499
    m_Localized: Rouge
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266500
    m_Localized: vert
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266501
    m_Localized: bleu
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266502
    m_Localized: "Saisie termin\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266503
    m_Localized: suivant
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266504
    m_Localized: "Marchez vers le personnage en balan\xE7ant vos bras !"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266505
    m_Localized: "Regardez \xE0 gauche et \xE0 droite et remplissez la jauge !"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266506
    m_Localized: "Levez la main gauche et traversez le passage pi\xE9ton."
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266507
    m_Localized: Terminez le tutoriel !!
    m_Metadata:
      m_Items: []
  - m_Id: 923310738452480
    m_Localized: "cor\xE9en"
    m_Metadata:
      m_Items: []
