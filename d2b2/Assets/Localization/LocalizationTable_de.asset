%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: LocalizationTable_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: fa88b033994461f419692bbaa512fc25, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 45166931968
    m_Localized: Es ist okay. Jeder kann Fehler machen.
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234827
    m_Localized: "Herzlichen Gl\xFCckwunsch! Sie haben alle \xDCbungen abgeschlossen!
      Gehen wir nun zum n\xE4chsten Kapitel \xFCber, um der K\xF6nig des sicheren
      Gehens zu werden?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234826
    m_Localized: "Herzlichen Gl\xFCckwunsch zum Erreichen des Titels \u201ESafe Pedestrian
      King\u201C im Kapitel \u201ECrossing the Alley\u201C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234825
    m_Localized: "Herzlichen Gl\xFCckwunsch zum Erreichen des Titels \u201EK\xF6nig
      der Fu\xDFg\xE4ngersicherheit\u201C im Kapitel \u201E\xDCberqueren des Zebrastreifens\u201C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234824
    m_Localized: "Du hast wirklich hart gearbeitet. Toll, dass du es so weit geschafft
      hast!\nIch schenke dir ein Fu\xDFg\xE4ngersicherheitszertifikat, wenn du alle
      Spiele geschafft hast!\nN\xE4chstes Mal schaffst du es noch besser!\n\nIch
      werde dich immer anfeuern."
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234823
    m_Localized: "Du hast hart gearbeitet!\nDu hast das Sicherheitsgehtraining erfolgreich
      abgeschlossen und ein Zertifikat erhalten!\nWenn du noch ein bisschen \xFCbst,
      kannst auch du um die Goldmedaille k\xE4mpfen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234822
    m_Localized: "Das war echt toll!\nDer Musterfu\xDFg\xE4nger, der das Sicherheits-Gehtraining
      perfekt absolviert hat, erh\xE4lt eine Teilnahmeurkunde!\nIch hoffe, du kannst
      auch in Zukunft sicher gehen?\n\nHerzlichen Gl\xFCckwunsch!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234821
    m_Localized: 3...2...1...Start!
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234820
    m_Localized: "In diesem Spiel musst du die Menschen um dich herum genau beobachten!\nFinde
      gef\xE4hrliche Personen und w\xE4hle sie mit dem Controller aus!\nWenn du sie
      richtig err\xE4tst, steigt deine Punktzahl, und wenn du sie falsch err\xE4tst,
      kann sie sinken!\nLass uns innerhalb des Zeitlimits so viele Personen wie m\xF6glich
      erraten! Bist du bereit?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234819
    m_Localized: "Jetzt bist du ein Experte f\xFCr tote Winkel!\nDann auf zum n\xE4chsten
      Ort!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234818
    m_Localized: "Schauen wir jetzt mal nach, wo unsere Freunde sind, die sich noch
      gut versteckt haben.\nH\xE4tte sich das Auto bewegt, w\xE4hrend unsere Freunde
      sich so versteckt hielten, w\xE4re es wirklich gef\xE4hrlich gewesen.\nDu wei\xDFt
      doch, wie gef\xE4hrlich tote Winkel sind, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234817
    m_Localized: 'Gut gemacht! Mal sehen, wie gut du deine Freunde gefunden hast.

      Oh,
      du hast sie gefunden?! Super gemacht!

      Aber ... dieser Freund hat sich
      echt gut versteckt, oder?'
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234816
    m_Localized: 'Wie schwer ist es, den toten Winkel zu erkennen? Lass es uns mit
      einem einfachen Spiel selbst erleben.

      Es werden sich schelmische Freunde
      rund ums Auto verstecken!

      Du musst sie finden und sie ausfindig machen!

      Wie
      viele schaffst du in der vorgegebenen Zeit?!

      Also, bist du bereit?!'
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040540
    m_Localized: "Tote Winkel sind Bereiche, die vom Fahrer nicht eingesehen werden
      k\xF6nnen.\nSie sind weder durch Fenster noch durch Spiegel sichtbar.\n\nEs
      ist wirklich gef\xE4hrlich, wenn ein Freund dabei ist.\nAlso \xFCberpr\xFCfe
      ihn ab jetzt mit eigenen Augen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040539
    m_Localized: "Dieses Mal habe ich ein ganz besonderes Erlebnis f\xFCr Sie!\nEs
      gibt so etwas wie einen toten Winkel im Auto!\nSehen Sie selbst, wie schwer
      es ist, etwas zu sehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040538
    m_Localized: "Mission \u201ESicheres Gehen durch die Gasse\u201C abgeschlossen!
      Jetzt kannst du die Gasse alleine \xFCberqueren, oder? Okay, fahren wir mit
      der n\xE4chsten Lektion fort?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040537
    m_Localized: Gute Arbeit! Du bist der Beste!
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040536
    m_Localized: Schauen Sie sich um!
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040535
    m_Localized: "Na dann, auf zum n\xE4chsten Ort!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040534
    m_Localized: "Jetzt sind Sie ein Experte f\xFCr den toten Winkel!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040533
    m_Localized: "Jetzt wissen Sie, wie gef\xE4hrlich tote Winkel sein k\xF6nnen,
      oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040532
    m_Localized: "Wenn sich das Auto bewegt h\xE4tte, w\xE4hrend meine Freunde sich
      so versteckt hielten, w\xE4re es wirklich gef\xE4hrlich gewesen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040531
    m_Localized: Schauen wir also jetzt nach, wo unsere Freunde sind, die sich bisher
      gut versteckt haben.
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040530
    m_Localized: Oh~ Du hast es gefunden?! Super gemacht! Aber... der Kerl hat sich
      echt gut versteckt, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040529
    m_Localized: Gut gemacht! Mal sehen, wie gut du deine Freunde gefunden hast.
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040528
    m_Localized: Also, bist du bereit?!
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040527
    m_Localized: "Wie viele Personen k\xF6nnen Sie in der vorgegebenen Zeit finden?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040526
    m_Localized: "Rund um das Auto verstecken sich spitzb\xFCbische Freunde! Du musst
      sie nur finden!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040525
    m_Localized: "Wie w\xE4re es, wenn Sie selbst erleben w\xFCrden, wie schlecht
      blinde Flecken bei einem einfachen Spiel erkannt werden?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040524
    m_Localized: Von nun an werden Sie es mit eigenen Augen sehen!
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040523
    m_Localized: "Ich kann durch das Fenster oder den Spiegel nicht gut sehen ...
      Es ist wirklich gef\xE4hrlich, wenn mein Freund da ist."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040522
    m_Localized: "Tote Winkel sind Bereiche, die f\xFCr den Fahrer nicht sichtbar
      sind."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040521
    m_Localized: "Es gibt so etwas wie einen toten Winkel im Auto! \xDCberzeugen
      Sie sich selbst, wie schwer es ist, dort etwas zu sehen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040520
    m_Localized: Dieses Mal haben wir ein ganz besonderes Erlebnis vorbereitet!
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040519
    m_Localized: "Heben Sie Ihre Hand und \xFCberqueren Sie die Stra\xDFe"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040518
    m_Localized: "Schauen Sie vor dem \xDCberqueren nach links und rechts"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040517
    m_Localized: "\xDCberqueren Sie die Stra\xDFe sicher!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040516
    m_Localized: "Heben Sie Ihre Hand und \xFCberqueren Sie die Stra\xDFe"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040515
    m_Localized: "Schauen Sie vor dem \xDCberqueren nach links und rechts"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040514
    m_Localized: "Erstens: H\xF6ren Sie auf."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040513
    m_Localized: "\xDCberqueren Sie die Stra\xDFe sicher!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040512
    m_Localized: Ich muss einen Freund treffen
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846235
    m_Localized: "Warten Sie, bis das gr\xFCne Licht aufleuchtet."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846234
    m_Localized: Hinter der gelben Sicherheitslinie ist es sicher.
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846233
    m_Localized: "Heben Sie Ihre Hand und \xFCberqueren Sie die Stra\xDFe."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846232
    m_Localized: "Heben Sie Ihre H\xE4nde hoch \xFCber Ihren Kopf."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846231
    m_Localized: Betrachten Sie beide Seiten
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846230
    m_Localized: "Lasst uns zur\xFCck auf die Stra\xDFe gehen und es noch einmal
      versuchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846229
    m_Localized: "Wie ist es? Jetzt wei\xDFt du, was zu tun ist, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846228
    m_Localized: "An Stellen, an denen Sie nicht voraussehen k\xF6nnen, halten Sie
      immer an und schauen Sie zuerst nach. Okay?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846227
    m_Localized: Sehen Sie, dieser Typ ist nicht einfach rausgegangen, er ist erst
      stehen geblieben und hat nach links und rechts geschaut?
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846226
    m_Localized: Na, wollen wir mal sehen, was wir jetzt tun?
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846225
    m_Localized: "Auf einer Stra\xDFe, auf der Sie nicht voraussehen k\xF6nnen, m\xFCssen
      Sie anhalten, pr\xFCfen und dann weiterfahren."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846224
    m_Localized: "Wenn wir uns nicht mehr so sehen k\xF6nnen wie gerade, k\xF6nnten
      wir in echte Schwierigkeiten geraten."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846223
    m_Localized: "Hey, dieser Typ \u2026 Er l\xE4uft einfach herum, ohne sich umzuschauen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846222
    m_Localized: "Wenn ich mir also angew\xF6hne, zuerst auf die Autos zu schauen,
      auch wenn sie mich nicht sehen k\xF6nnen, bin ich viel sicherer."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846221
    m_Localized: "Selbst wenn Sie das Auto erkennen, kann es gef\xE4hrlicher sein,
      wenn Sie denken: \u201EJetzt ist alles in Ordnung\u201C und einfach weiterfahren."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846220
    m_Localized: "An Orten wie diesen, wo wir durch Mauern oder Autos blockiert sind,
      k\xF6nnen wir ein kommendes Auto nicht im Voraus sehen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846219
    m_Localized: Bevor Sie also in eine Gasse oder an einen uneinsehbaren Ort gehen,
      sollten Sie unbedingt noch einmal nachsehen.
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846218
    m_Localized: "Genau wie jetzt k\xF6nnen Autos von der Seite kommen, die Sie nicht
      sehen k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846217
    m_Localized: "Lasst uns zur\xFCck auf die Stra\xDFe gehen und es noch einmal
      versuchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846216
    m_Localized: "Wie ist es? Jetzt wei\xDFt du, was zu tun ist, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846215
    m_Localized: "Gehen Sie beim \xDCberholen eines fahrenden Fahrzeugs immer so
      vor, dass der Fahrer Sie sehen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846214
    m_Localized: Schauen Sie, dieser Typ, anstatt nach hinten im Auto zu gehen, warum
      gehen Sie nicht an eine Position, wo der Fahrer Sie sehen kann?
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846213
    m_Localized: Na, wollen wir mal sehen, was wir jetzt tun?
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846212
    m_Localized: Deshalb sollten wir uns nie im toten Winkel des Fahrers aufhalten.
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846211
    m_Localized: "W\xE4re das Auto noch ein St\xFCck weiter gefahren, w\xE4ren wir
      fast abgest\xFCrzt! Ist das nicht unglaublich gef\xE4hrlich?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846210
    m_Localized: "Ein Auto versperrt den Blick auf meinen Freund, sodass ich ihn
      von innen \xFCberhaupt nicht sehen kann."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846209
    m_Localized: "Wir nennen diese Stellen \u201Etote Winkel\u201C. Deshalb m\xFCssen
      wir an diesen Stellen vorsichtiger sein."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846208
    m_Localized: "Das Gleiche gilt f\xFCr Personen in Autos. Auch Sie sind m\xF6glicherweise
      nicht sichtbar."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651936
    m_Localized: "Wenn Sie hier hinschauen, k\xF6nnen Sie nicht das Gesicht der Person
      im Auto sehen?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651935
    m_Localized: "Wenn das Auto also anf\xE4ngt, sich zu drehen oder zu bewegen,
      kann das wirklich gef\xE4hrlich sein."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651934
    m_Localized: "Tats\xE4chlich hat der Fahrer Sie dort m\xF6glicherweise nicht
      gesehen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651933
    m_Localized: "Lassen Sie uns gemeinsam herausfinden, warum es gef\xE4hrlich war!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651932
    m_Localized: Es ist okay! Das wussten Sie vielleicht nicht.
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651931
    m_Localized: "Schau! So kommst du ganz sicher \xFCber die Stra\xDFe!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651930
    m_Localized: Schauen Sie zuerst nach links und rechts ...
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651929
    m_Localized: Na, wollen wir mal sehen, was wir jetzt tun?
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651928
    m_Localized: "Wow! Ich bin wirklich \xFCberrascht! Selbst bei Gr\xFCn k\xF6nnen
      Autos kommen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651927
    m_Localized: "Schauen Sie, dieser Typ \xFCberquert die Stra\xDFe, sobald die
      Ampel gr\xFCn wird."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651926
    m_Localized: "Daher m\xFCssen Sie vor dem \xDCberqueren zun\xE4chst pr\xFCfen,
      ob das Auto angehalten hat."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651925
    m_Localized: Auch wenn die Ampel umschaltet, kann es sein, dass von der Seite
      ein Auto kommt.
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651924
    m_Localized: "Manchmal verpassen Autos das Signal und fahren einfach vorbei,
      deshalb m\xFCssen wir zuerst nachsehen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651923
    m_Localized: "Fr\xFCher ging man, sobald die Ampel gr\xFCn war, einfach \xFCber
      die Stra\xDFe, ohne etwas zu beachten."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651922
    m_Localized: "Lasst uns zur\xFCck auf die Stra\xDFe gehen und es noch einmal
      versuchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651921
    m_Localized: "Wie ist es? Jetzt wei\xDFt du, was zu tun ist, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651920
    m_Localized: "Dann k\xF6nnen Autofahrer Sie schnell erkennen und sicher die Stra\xDFe
      \xFCberqueren!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651919
    m_Localized: "Hebt dieser Typ nicht seine Hand, wenn er die Grenze \xFCberquert?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651918
    m_Localized: Na, wollen wir mal sehen, was wir jetzt tun?
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651917
    m_Localized: "Wenn Sie Ihre Hand nicht heben, kann der Fahrer Sie m\xF6glicherweise
      nicht sehen und es kann schwierig sein, anzuhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651916
    m_Localized: "Sehen Sie, er geht einfach \xFCber die Stra\xDFe, ohne auch nur
      die Hand zu heben."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651915
    m_Localized: "Deshalb ist es f\xFCr uns besser, zuerst die Hand zu heben und
      es ihnen mitzuteilen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651914
    m_Localized: Menschen in Autos haben manchmal Schwierigkeiten, nach vorne oder
      zur Seite zu sehen.
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651913
    m_Localized: Na, dann muss man doch vorsichtig sein, oder?
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651912
    m_Localized: "Wenn Sie Ihre Hand nicht heben, werden Sie von den Leuten im Auto
      m\xF6glicherweise nicht gesehen und das Auto f\xE4hrt einfach vorbei!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651911
    m_Localized: Du bist vorhin einfach weggegangen, oder? Du hast nicht einmal die
      Hand gehoben.
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651910
    m_Localized: "Schauen wir uns an, warum das, was gerade passiert ist, gef\xE4hrlich
      war!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651909
    m_Localized: Es ist okay. Jeder kann Fehler machen.
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651908
    m_Localized: "Lasst uns zur\xFCck auf die Stra\xDFe gehen und es noch einmal
      versuchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651907
    m_Localized: "Wie ist es? Jetzt wei\xDFt du, was zu tun ist, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651906
    m_Localized: "Denken Sie immer daran, dass Ihre Sicherheit durch die Befolgung
      des Signals gew\xE4hrleistet ist."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651905
    m_Localized: "Wenn die Ampel gr\xFCn wird, schauen Sie nach links und rechts,
      heben Sie die Hand und \xFCberqueren Sie langsam die Stra\xDFe."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651904
    m_Localized: "Bei Rot m\xFCssen Sie hinter der gelben Sicherheitslinie anhalten,
      und zwar so."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457628
    m_Localized: Okay, dieses Mal zeige ich Ihnen in aller Ruhe, wie Sie sicher bleiben.
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457627
    m_Localized: "Beim \xDCberqueren der Stra\xDFe m\xFCssen Sie daher der Ampel
      folgen und d\xFCrfen nur die daf\xFCr vorgesehene Stra\xDFe \xFCberqueren."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457626
    m_Localized: "Aber wenn wir das nicht im Hinterkopf behalten, wird es zu gef\xE4hrlich,
      weil weder das Auto noch ich wissen, was zu tun ist."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457625
    m_Localized: "Ampeln und Zebrastreifen sollen daf\xFCr sorgen, dass Autos wissen,
      wann und wo die Stra\xDFe \xFCberquert werden soll."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457624
    m_Localized: "Im Ernst, es k\xF6nnte sofort zu einem schweren Unfall f\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457623
    m_Localized: "In solchen Momenten kann das Auto Sie nicht sehen und es ist f\xFCr
      das Auto fast unm\xF6glich anzuhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457622
    m_Localized: "Haben Sie gerade die Stra\xDFe bei Rot \xFCberquert? Oder sind
      Sie auf die Stra\xDFe gelaufen, als es kein Zebrastreifen war?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457621
    m_Localized: "Warum hast du so etwas Gef\xE4hrliches getan? Selbst im Scherz
      sollte man so etwas niemals tun."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457620
    m_Localized: "Das war \u2026 etwas, was ich wirklich nicht h\xE4tte tun sollen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457619
    m_Localized: "Lasst uns zur\xFCck auf die Stra\xDFe gehen und es noch einmal
      versuchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457618
    m_Localized: "Wie ist es? Jetzt wei\xDFt du, was zu tun ist, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457617
    m_Localized: Ich bin sicher, dass du es schaffst. Ich glaube an dich!
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457616
    m_Localized: "Es ist ganz einfach! Wenn Sie auf der Stra\xDFe gehen, gehen Sie
      einfach geradeaus bis zum Ende, ohne anzuhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457615
    m_Localized: Okay, schauen wir uns an, wie es geht.
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457614
    m_Localized: "Kommt es zu einem derartigen Stau, kann dies sowohl f\xFCr Autos
      als auch f\xFCr Fu\xDFg\xE4nger gef\xE4hrlich werden."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457613
    m_Localized: "Wenn Sie so pl\xF6tzlich anhalten, wie Sie es gerade getan haben,
      k\xF6nnten die Leute hinter Ihnen \xFCberrascht werden und verletzt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457612
    m_Localized: "Auf der Stra\xDFe ist es am sichersten, einfach weiterzugehen,
      ohne anzuhalten."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457611
    m_Localized: "Wenn der Fluss auf diese Weise durcheinander ger\xE4t, kann eine
      gef\xE4hrlichere Situation entstehen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457610
    m_Localized: "Wenn Sie anhalten, sind das Auto und die Leute hinter Ihnen m\xF6glicherweise
      verwirrt und fragen: \u201EH\xE4? Warum haben Sie angehalten?\u201C"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457609
    m_Localized: "Das Auto hat angehalten, weil es dachte, Sie w\xFCrden weiterlaufen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457608
    m_Localized: "Die Stra\xDFe ist zu gef\xE4hrlich, um einfach nur dort zu stehen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457607
    m_Localized: "Wenn Sie pl\xF6tzlich anhalten, kann die Umgebung chaotisch werden."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457606
    m_Localized: Alle haben darauf gewartet, dass du gehst
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457605
    m_Localized: "Sie sind gerade \xFCber die Stra\xDFe gegangen und pl\xF6tzlich
      mitten auf der Stra\xDFe stehen geblieben?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457604
    m_Localized: "Schauen wir uns an, warum das, was gerade passiert ist, gef\xE4hrlich
      war!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457603
    m_Localized: Es ist okay. Jeder kann Fehler machen.
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457602
    m_Localized: "Lasst uns zur\xFCck auf die Stra\xDFe gehen und es noch einmal
      versuchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457601
    m_Localized: "Wie ist es? Jetzt wei\xDFt du, was zu tun ist, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457600
    m_Localized: "Wenn Sie so warten und dann \xFCberqueren, k\xF6nnen Sie die Stra\xDFe
      sicher \xFCberqueren!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263318
    m_Localized: "K\xF6nnen Sie sich vorstellen, dass dieser Typ anh\xE4lt, wenn
      die Ampel blinkt, und auf das n\xE4chste Signal wartet?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263317
    m_Localized: Na, wollen wir mal sehen, was wir jetzt tun?
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263316
    m_Localized: "Wenn du dich nicht an die Regeln h\xE4ltst, kann es zu solchen
      Situationen kommen! Halte dich also unbedingt an sie! Nur so bist du wirklich
      sicher."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263315
    m_Localized: Ahh! Ich wusste es!
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263314
    m_Localized: "Schauen Sie, es blinkt gerade, aber wenn Sie es einfach \xFCberqueren
      ..."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263313
    m_Localized: "Wenn Sie zu diesem Zeitpunkt die Stra\xDFe \xFCberqueren, bleiben
      Sie m\xF6glicherweise mitten auf der Stra\xDFe stehen oder es kommt ein Auto
      angerannt."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263312
    m_Localized: "Wenn das gr\xFCne Licht blinkt, bedeutet dies, dass es bald rot
      wird."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263311
    m_Localized: "In diesem Moment ist es zu gef\xE4hrlich, die Stra\xDFe zu \xFCberqueren,
      da dies bedeutet, dass die Ampel bald umschaltet."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263310
    m_Localized: "Sie haben mit dem \xDCberqueren begonnen, als die gr\xFCne Ampel
      zu blinken begann, richtig?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263309
    m_Localized: "Schauen wir uns an, warum das, was gerade passiert ist, gef\xE4hrlich
      war!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263308
    m_Localized: Es ist okay. Jeder kann Fehler machen.
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263307
    m_Localized: "Lasst uns zur\xFCck auf die Stra\xDFe gehen und es noch einmal
      versuchen!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263306
    m_Localized: "Wie ist es? Jetzt wei\xDFt du, was zu tun ist, oder?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263305
    m_Localized: Auf diese Weise kann der Fahrer Sie besser sehen und es ist viel
      sicherer!
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263304
    m_Localized: Schauen Sie, dieser Typ wartet direkt hinter der gelben Linie!
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263303
    m_Localized: "Schauen wir uns also an, wie wir uns sch\xFCtzen k\xF6nnen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263302
    m_Localized: "Es k\xF6nnte tats\xE4chlich passieren, dass Sie von einem Auto
      angefahren werden, wenn es kommt!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263301
    m_Localized: "Schauen Sie, wenn Sie so zu weit nach vorne gehen \u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263300
    m_Localized: "Und wer zu weit nach vorne f\xE4hrt, l\xE4uft Gefahr, mit einem
      Auto zusammenzusto\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263299
    m_Localized: "Der Grund f\xFCr die Sicherheitslinien besteht darin, dass wir
      f\xFCr die Autofahrer leichter zu sehen sind."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263298
    m_Localized: "Diese Linie ist ein Stoppschild. Das Ignorieren dieser Linie kann
      zu einem schweren Unfall f\xFChren."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263297
    m_Localized: "Der Grund, warum Ihr Handeln gerade gef\xE4hrlich war, lag darin,
      dass Sie die gelbe Linie \xFCberquert haben."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263296
    m_Localized: "Lassen Sie uns gemeinsam einen Blick darauf werfen, warum das,
      was gerade passiert ist, gef\xE4hrlich war!"
    m_Metadata:
      m_Items: []
