      m_Items: []
  - m_Id: 28671530807326
    m_Localized: "Gleichm\xE4\xDFige Rotationsgeschwindigkeit"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807327
    m_Localized: Langsam
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807328
    m_Localized: Geschwindigkeit
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807329
    m_Localized: "Volle Lautst\xE4rke"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807330
    m_Localized: "BGM-Lautst\xE4rke"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807331
    m_Localized: "Lautst\xE4rke der Sprachf\xFChrung"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807332
    m_Localized: "Lautst\xE4rke der Soundeffekte"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807333
    m_Localized: "Wie hei\xDFt du?"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807334
    m_Localized: Bitte geben Sie Ihren Namen ein.
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807335
    m_Localized: "Koreanische, englische Gro\xDF- und Kleinbuchstaben sind m\xF6glich"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807336
    m_Localized: Keine Leerzeichen/Keine Anfangskonsonanten/Maximal 8 Zeichen
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807337
    m_Localized: Vorsicht
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807338
    m_Localized: Elterliche Aufsicht erforderlich
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807339
    m_Localized: "Seien Sie vorsichtig bei gro\xDFen Bewegungen wie dem Heben der
      Arme oder dem Drehen des Kopfes."
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807340
    m_Localized: "H\xF6ren Sie sofort auf, wenn Ihnen schwindelig wird."
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807341
    m_Localized: "M\xF6chten Sie es unten als Spitznamen festlegen?"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807342
    m_Localized: "Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807343
    m_Localized: Einrichtung des Spitznamens abgeschlossen!
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807344
