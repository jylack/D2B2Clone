    m_Metadata:
      m_Items: []
  - m_Id: 913980316266497
    m_Localized: Korrektur der Farbenblindheit
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266498
    m_Localized: Aus
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266499
    m_Localized: Rot
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266500
    m_Localized: "Gr\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266501
    m_Localized: Blau
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266502
