    m_Metadata:
      m_Items: []
  - m_Id: 913980316266503
    m_Localized: "n\xE4chste"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266504
    m_Localized: Gehen Sie mit schwingenden Armen auf die Figur zu!
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266505
    m_Localized: "Schauen Sie nach links und rechts und f\xFCllen Sie die Anzeige
      auf!"
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266506
    m_Localized: "Heben Sie Ihre linke Hand und \xFCberqueren Sie den Zebrastreifen."
    m_Metadata:
      m_Items: []
  - m_Id: 913980316266507
    m_Localized: "Schlie\xDFe das Tutorial ab!!"
    m_Metadata:
      m_Items: []
