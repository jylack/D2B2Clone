  m_TableData:
  - m_Id: 45166931968
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u043C\u043E\u0436\u0435\u0442 \u043E\u0448\u0438\u0431\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234827
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E \u0441
      \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435\u043C \u0443\u0440\u043E\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234826
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C
      \u0441 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435\u043C \u0442\u0438\u0442\u0443\u043B\u0430
      \xAB\u041A\u043E\u0440\u043E\u043B\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0445
      \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043E\u0432\xBB \u0432 \u0433\u043B\u0430\u0432\u0435
      \xAB\u041F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0430\xBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234825
    m_Localized: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u0435\u043C
      \u0441 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435\u043C \u0442\u0438\u0442\u0443\u043B\u0430
      \xAB\u041A\u043E\u0440\u043E\u043B\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0445
      \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043E\u0432\xBB \u0432 \u0433\u043B\u0430\u0432\u0435
      \xAB\u041F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043D\u0438\u0435 \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043D\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430\xBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234824
    m_Localized: "\u0422\u044B \u043E\u0447\u0435\u043D\u044C \u0443\u0441\u0435\u0440\u0434\u043D\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430\u043B~ \u0417\u0434\u043E\u0440\u043E\u0432\u043E,
      \u0447\u0442\u043E \u0442\u044B \u0437\u0430\u0448\u0435\u043B \u0442\u0430\u043A
      \u0434\u0430\u043B\u0435\u043A\u043E!\n\u042F \u0432\u044B\u0434\u0430\u043C
      \u0442\u0435\u0431\u0435 \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u0430
      \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0432\u0441\u0435\u0445 \u0438\u0433\u0440!\n\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u0442\u044B \u0441\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F
      \u0435\u0449\u0435 \u043B\u0443\u0447\u0448\u0435!\n\n\u042F \u0432\u0441\u0435\u0433\u0434\u0430
      \u0431\u0443\u0434\u0443 \u0442\u0435\u0431\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C~"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234823
    m_Localized: "\u0412\u044B \u0443\u0441\u0435\u0440\u0434\u043D\u043E \u0442\u0440\u0443\u0434\u0438\u043B\u0438\u0441\u044C~!\n\u0412\u044B
      \u0443\u0441\u043F\u0435\u0448\u043D\u043E \u043F\u0440\u043E\u0448\u043B\u0438
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435 \u043F\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439
      \u0445\u043E\u0434\u044C\u0431\u0435 \u0438 \u0441\u043C\u043E\u0433\u043B\u0438
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442!\n\u0415\u0441\u043B\u0438
      \u0432\u044B \u043F\u043E\u0442\u0440\u0435\u043D\u0438\u0440\u0443\u0435\u0442\u0435\u0441\u044C
      \u0435\u0449\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u0432\u044B
      \u0442\u043E\u0436\u0435 \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0431\u043E\u0440\u043E\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0437\u043E\u043B\u043E\u0442\u0443\u044E \u043C\u0435\u0434\u0430\u043B\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234822
    m_Localized: "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0434\u043E\u0440\u043E\u0432\u043E!\n\u0421\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442
      \u043E\u0431 \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u0438 \u0432\u044B\u0434\u0430\u0435\u0442\u0441\u044F
      \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432\u043E\u043C\u0443 \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u0443,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0442\u043B\u0438\u0447\u043D\u043E
      \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439 \u0445\u043E\u0434\u044C\u0431\u0435!\n\u041D\u0430\u0434\u0435\u044E\u0441\u044C,
      \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E
      \u0445\u043E\u0434\u0438\u0442\u044C \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C?\n\n\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E
      \u043E\u0442 \u0432\u0441\u0435\u0433\u043E \u0441\u0435\u0440\u0434\u0446\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234821
    m_Localized: "3...2...1...\u0441\u0442\u0430\u0440\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234820
    m_Localized: "\u042D\u0442\u043E \u0438\u0433\u0440\u0430, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0432\u0430\u043C \u043D\u0443\u0436\u043D\u043E \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C \u0437\u0430 \u043B\u044E\u0434\u044C\u043C\u0438
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0432\u0430\u0441!\n\u041D\u0430\u0439\u0434\u0438\u0442\u0435
      \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043E\u043F\u0430\u0441\u043D\u043E \u0445\u043E\u0434\u044F\u0442, \u0438
      \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0445 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0430!\n\u0415\u0441\u043B\u0438
      \u0432\u044B \u043D\u0430\u0439\u0434\u0435\u0442\u0435 \u0438\u0445 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
      \u0432\u0430\u0448 \u0441\u0447\u0435\u0442 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u0441\u044F,
      \u0430 \u0435\u0441\u043B\u0438 \u0432\u044B \u043E\u0448\u0438\u0431\u0435\u0442\u0435\u0441\u044C,
      \u0432\u0430\u0448 \u0441\u0447\u0435\u0442 \u043C\u043E\u0436\u0435\u0442
      \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C\u0441\u044F!\n\u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u0443\u0433\u0430\u0434\u0430\u0435\u043C \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439 \u0437\u0430
      \u043E\u0442\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F!
      \u0412\u044B \u0433\u043E\u0442\u043E\u0432\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234819
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u044D\u043A\u0441\u043F\u0435\u0440\u0442
      \u043F\u043E \u0441\u043B\u0435\u043F\u044B\u043C \u0437\u043E\u043D\u0430\u043C~!\n\u0422\u043E\u0433\u0434\u0430
      \u043F\u043E\u0439\u0434\u0435\u043C \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
      \u043B\u043E\u043A\u0430\u0446\u0438\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234818
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C, \u0433\u0434\u0435 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u043D\u0430\u0448\u0438 \u0434\u0440\u0443\u0437\u044C\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u0441\u0435 \u0435\u0449\u0435 \u0445\u043E\u0440\u043E\u0448\u043E
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C.\n\u0415\u0441\u043B\u0438
      \u0431\u044B \u043C\u0430\u0448\u0438\u043D\u0430 \u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C,
      \u043F\u043E\u043A\u0430 \u043D\u0430\u0448\u0438 \u0434\u0440\u0443\u0437\u044C\u044F
      \u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C, \u044D\u0442\u043E
      \u0431\u044B\u043B\u043E \u0431\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u043E.\n\u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043E\u043F\u0430\u0441\u043D\u044B \u0441\u043B\u0435\u043F\u044B\u0435 \u0437\u043E\u043D\u044B,
      \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234817
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u043A\u0430\u043A
      \u0445\u043E\u0440\u043E\u0448\u043E \u0442\u044B \u043D\u0430\u0448\u0451\u043B
      \u0441\u0432\u043E\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439.\n\u041E~
      \u0422\u044B \u043D\u0430\u0448\u0451\u043B \u0438\u0445?! \u0422\u044B \u043E\u0442\u043B\u0438\u0447\u043D\u043E
      \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u043B!\n\u041D\u043E... \u044D\u0442\u043E\u0442
      \u0434\u0440\u0443\u0433 \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0441\u044F
      \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E, \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232915234816
    m_Localized: "\u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0436\u043D\u043E
      \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0441\u043B\u0435\u043F\u0443\u044E
      \u0437\u043E\u043D\u0443? \u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0438\u0441\u043F\u044B\u0442\u0430\u0435\u043C
      \u044D\u0442\u043E \u0441\u0430\u043C\u0438 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0438\u0433\u0440\u044B.\n\u0412\u043E\u043A\u0440\u0443\u0433
      \u043C\u0430\u0448\u0438\u043D\u044B \u0431\u0443\u0434\u0443\u0442 \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F
      \u043E\u0437\u043E\u0440\u043D\u044B\u0435 \u0434\u0440\u0443\u0437\u044C\u044F!\n\u0412\u044B
      \u0434\u043E\u043B\u0436\u043D\u044B \u0443\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0430 \u043D\u0438\u0445 \u0438 \u043D\u0430\u0439\u0442\u0438 \u0438\u0445!\n\u0421\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0439\u0442\u0438
      \u0437\u0430 \u043E\u0442\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F?!\n\u0418\u0442\u0430\u043A~
      \u0412\u044B \u0433\u043E\u0442\u043E\u0432\u044B?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040540
    m_Localized: "\u0421\u043B\u0435\u043F\u044B\u0435 \u0437\u043E\u043D\u044B \u2014
      \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u043D\u0435 \u0432\u0438\u0434\u0438\u0442.\n\u041E\u043D\u0438 \u043D\u0435
      \u0432\u0438\u0434\u043D\u044B \u0447\u0435\u0440\u0435\u0437 \u043E\u043A\u043D\u0430
      \u0438\u043B\u0438 \u0437\u0435\u0440\u043A\u0430\u043B\u0430\u2026\n\n\u042D\u0442\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u043E, \u0435\u0441\u043B\u0438 \u0442\u0430\u043C
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432\u0430\u0448 \u0434\u0440\u0443\u0433.\n\u0422\u0430\u043A
      \u0447\u0442\u043E \u0441 \u044D\u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430
      \u0432\u044B \u0431\u0443\u0434\u0435\u0442\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C
      \u044D\u0442\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040539
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u044F
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
      \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u044B\u0439 \u043E\u043F\u044B\u0442!\n\u0412
      \u043C\u0430\u0448\u0438\u043D\u0435 \u0435\u0441\u0442\u044C \u043D\u0435\u0447\u0442\u043E,
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u043E\u0435 \u0441\u043B\u0435\u043F\u043E\u0439
      \u0437\u043E\u043D\u043E\u0439!\n\u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u0441\u0430\u043C\u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0436\u043D\u043E
      \u0432\u0438\u0434\u0435\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040538
    m_Localized: "\u041C\u0438\u0441\u0441\u0438\u044F \u043F\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C\u0443
      \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0443 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430!
      \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043F\u0435\u0440\u0435\u0443\u043B\u043E\u043A
      \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0432\u0435\u0440\u043D\u043E? \u0425\u043E\u0440\u043E\u0448\u043E~ \u041F\u0435\u0440\u0435\u0439\u0434\u0435\u043C
      \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443 \u0443\u0440\u043E\u043A\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040537
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u0422\u044B \u043B\u0443\u0447\u0448\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040536
    m_Localized: "\u041E\u0433\u043B\u044F\u043D\u0438\u0442\u0435\u0441\u044C \u0432\u043E\u043A\u0440\u0443\u0433!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040535
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u043F\u043E\u0439\u0434\u0435\u043C
      \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u043C\u0435\u0441\u0442\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040534
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u044D\u043A\u0441\u043F\u0435\u0440\u0442
      \u043F\u043E \u0441\u043B\u0435\u043F\u044B\u043C \u0437\u043E\u043D\u0430\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040533
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435,
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u043F\u0430\u0441\u043D\u044B\u043C\u0438
      \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u0441\u043B\u0435\u043F\u044B\u0435
      \u0437\u043E\u043D\u044B, \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040532
    m_Localized: "\u0415\u0441\u043B\u0438 \u0431\u044B \u043C\u0430\u0448\u0438\u043D\u0430
      \u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C \u0441 \u043C\u0435\u0441\u0442\u0430,
      \u043F\u043E\u043A\u0430 \u043C\u043E\u0438 \u0434\u0440\u0443\u0437\u044C\u044F
      \u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C, \u044D\u0442\u043E
      \u0431\u044B\u043B\u043E \u0431\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040531
    m_Localized: "\u0418\u0442\u0430\u043A, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C, \u0433\u0434\u0435 \u0436\u0435
      \u043D\u0430\u0448\u0438 \u0434\u0440\u0443\u0437\u044C\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0445\u043E\u0440\u043E\u0448\u043E
      \u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040530
    m_Localized: "\u041E~ \u0422\u044B \u043D\u0430\u0448\u0435\u043B \u0435\u0433\u043E?!
      \u0422\u044B \u043F\u0440\u043E\u0434\u0435\u043B\u0430\u043B \u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443! \u041D\u043E... \u044D\u0442\u043E\u0442
      \u043F\u0430\u0440\u0435\u043D\u044C \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0441\u044F, \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040529
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0445\u043E\u0440\u043E\u0448\u043E \u0442\u044B \u043D\u0430\u0448\u0435\u043B
      \u0441\u0432\u043E\u0438\u0445 \u0434\u0440\u0443\u0437\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040528
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E, \u0432\u044B \u0433\u043E\u0442\u043E\u0432\u044B?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040527
    m_Localized: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0434\u0435\u0439
      \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043D\u0430\u0439\u0442\u0438
      \u0437\u0430 \u043E\u0442\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F?!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040526
    m_Localized: "\u0412\u043E\u043A\u0440\u0443\u0433 \u043C\u0430\u0448\u0438\u043D\u044B
      \u0431\u0443\u0434\u0443\u0442 \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F
      \u043E\u0437\u043E\u0440\u043D\u044B\u0435 \u0434\u0440\u0443\u0437\u044C\u044F!
      \u0412\u0430\u043C \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0443\u0436\u043D\u043E
      \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0430 \u043D\u0438\u0445
      \u0438 \u043D\u0430\u0439\u0442\u0438 \u0438\u0445!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040525
    m_Localized: "\u0410 \u043A\u0430\u043A \u043D\u0430\u0441\u0447\u0435\u0442
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043B\u0438\u0447\u043D\u043E
      \u0443\u0431\u0435\u0434\u0438\u0442\u044C\u0441\u044F, \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043F\u043B\u043E\u0445\u043E \u0432\u0438\u0434\u043D\u044B \u0441\u043B\u0435\u043F\u044B\u0435
      \u0437\u043E\u043D\u044B \u0432 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
      \u0438\u0433\u0440\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040524
    m_Localized: "\u0422\u0430\u043A \u0447\u0442\u043E \u043E\u0442\u043D\u044B\u043D\u0435
      \u0432\u044B \u0443\u0432\u0438\u0434\u0438\u0442\u0435 \u0432\u0441\u0435
      \u044D\u0442\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040523
    m_Localized: "\u042F \u043D\u0435 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E
      \u0432\u0438\u0436\u0443 \u0447\u0435\u0440\u0435\u0437 \u043E\u043A\u043D\u043E
      \u0438\u043B\u0438 \u0437\u0435\u0440\u043A\u0430\u043B\u043E... \u042D\u0442\u043E
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u043E, \u0435\u0441\u043B\u0438 \u0442\u0430\u043C
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043C\u043E\u0439 \u0434\u0440\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040522
    m_Localized: "\u0421\u043B\u0435\u043F\u044B\u0435 \u0437\u043E\u043D\u044B \u2014
      \u044D\u0442\u043E \u043E\u0431\u043B\u0430\u0441\u0442\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043D\u0435 \u0432\u0438\u0434\u043D\u044B \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040521
    m_Localized: "\u0412 \u043C\u0430\u0448\u0438\u043D\u0435 \u0435\u0441\u0442\u044C
      \u043D\u0435\u0447\u0442\u043E, \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u043E\u0435
      \u0441\u043B\u0435\u043F\u043E\u0439 \u0437\u043E\u043D\u043E\u0439! \u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u0441\u0430\u043C\u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0436\u043D\u043E
      \u0447\u0442\u043E-\u0442\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040520
    m_Localized: "\u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043C\u044B
      \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B\u0438 \u043D\u0435\u0447\u0442\u043E
      \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040519
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u0440\u0443\u043A\u0443
      \u0438 \u043F\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0443\u043B\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040518
    m_Localized: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430\u043B\u0435\u0432\u043E
      \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043E, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040517
    m_Localized: "\u041F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435 \u0443\u043B\u0438\u0446\u0443
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040516
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u0440\u0443\u043A\u0443
      \u0438 \u043F\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0443\u043B\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040515
    m_Localized: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430\u043B\u0435\u0432\u043E
      \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043E, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040514
    m_Localized: "\u041F\u0440\u0435\u0436\u0434\u0435 \u0432\u0441\u0435\u0433\u043E,
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040513
    m_Localized: "\u041F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435 \u0443\u043B\u0438\u0446\u0443
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232911040512
    m_Localized: "\u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F
      \u0441 \u0434\u0440\u0443\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846235
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u0437\u0430\u0433\u043E\u0440\u0438\u0442\u0441\u044F \u0437\u0435\u043B\u0435\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846234
    m_Localized: "\u0417\u0430 \u0436\u0435\u043B\u0442\u043E\u0439 \u043B\u0438\u043D\u0438\u0435\u0439
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846233
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u0440\u0443\u043A\u0443
      \u0438 \u043F\u0435\u0440\u0435\u0439\u0434\u0438\u0442\u0435 \u0443\u043B\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846232
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u0440\u0443\u043A\u0438
      \u0432\u044B\u0441\u043E\u043A\u043E \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846231
    m_Localized: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430
      \u043E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846230
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u0435\u0440\u043D\u0435\u043C\u0441\u044F
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846229
    m_Localized: "\u041D\u0443 \u043A\u0430\u043A? \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C,
      \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846228
    m_Localized: "\u0412 \u043C\u0435\u0441\u0442\u0430\u0445, \u0433\u0434\u0435
      \u0432\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438\u0434\u0435\u0442\u044C
      \u0432\u043F\u0435\u0440\u0435\u0434, \u0432\u0441\u0435\u0433\u0434\u0430
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C
      \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439\u0442\u0435 \u0441\u043D\u0430\u0447\u0430\u043B\u0430.
      \u0425\u043E\u0440\u043E\u0448\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846227
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u044D\u0442\u043E\u0442
      \u043F\u0430\u0440\u0435\u043D\u044C \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0432\u044B\u0448\u0435\u043B, \u043E\u043D \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430\u043B\u0435\u0432\u043E \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846226
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846225
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435, \u0433\u0434\u0435
      \u0432\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u0438\u0434\u0435\u0442\u044C
      \u0432\u043F\u0435\u0440\u0435\u0434, \u0432\u0430\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F, \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443, \u0430 \u0437\u0430\u0442\u0435\u043C
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846224
    m_Localized: "\u0415\u0441\u043B\u0438 \u043C\u044B \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u043C
      \u0432\u0438\u0434\u0435\u0442\u044C\u0441\u044F \u0434\u0440\u0443\u0433 \u0441
      \u0434\u0440\u0443\u0433\u043E\u043C, \u043A\u0430\u043A \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0443 \u043D\u0430\u0441 \u043C\u043E\u0433\u0443\u0442 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u0443\u0442\u044C
      \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u044B\u0435 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846223
    m_Localized: "\u042D\u0439, \u044D\u0442\u043E\u0442 \u043F\u0430\u0440\u0435\u043D\u044C...
      \u041E\u043D \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0434\u0435\u0442,
      \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846222
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443, \u0435\u0441\u043B\u0438
      \u044F \u0432\u043E\u0437\u044C\u043C\u0443 \u0432 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0443
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043C\u0430\u0448\u0438\u043D\u044B, \u0434\u0430\u0436\u0435
      \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u043C\u0435\u043D\u044F \u043D\u0435
      \u0432\u0438\u0434\u044F\u0442, \u044F \u0431\u0443\u0434\u0443 \u0432 \u0433\u043E\u0440\u0430\u0437\u0434\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846221
    m_Localized: "\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0432\u044B
      \u0443\u0437\u043D\u0430\u043B\u0438 \u043C\u0430\u0448\u0438\u043D\u0443,
      \u043D\u043E \u0434\u0443\u043C\u0430\u0435\u0442\u0435: \xAB\u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0441\u0435 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435\xBB \u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u0435\u0434\u0435\u0442\u0435 \u0434\u0430\u043B\u044C\u0448\u0435,
      \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043E\u043F\u0430\u0441\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846220
    m_Localized: "\u0412 \u0442\u0430\u043A\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445,
      \u0433\u0434\u0435 \u043D\u0430\u0441 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u044E\u0442
      \u0441\u0442\u0435\u043D\u044B \u0438\u043B\u0438 \u043C\u0430\u0448\u0438\u043D\u044B,
      \u043C\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u043C \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044E\u0449\u0443\u044E\u0441\u044F
      \u043C\u0430\u0448\u0438\u043D\u0443 \u0437\u0430\u0440\u0430\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846219
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0438\u0434\u0442\u0438 \u0432 \u043F\u0435\u0440\u0435\u0443\u043B\u043E\u043A
      \u0438\u043B\u0438 \u043A\u0443\u0434\u0430-\u0442\u043E, \u0433\u0434\u0435
      \u0432\u0430\u0441 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0438\u0434\u0438\u0442,
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u0435\u0449\u0435 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846218
    m_Localized: "\u0422\u0430\u043A \u0436\u0435, \u043A\u0430\u043A \u0438 \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0438 \u043C\u043E\u0433\u0443\u0442
      \u0432\u044B\u0435\u0445\u0430\u0442\u044C \u0441 \u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B \u043D\u0435 \u0432\u0438\u0434\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846217
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u0435\u0440\u043D\u0435\u043C\u0441\u044F
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846216
    m_Localized: "\u041D\u0443 \u043A\u0430\u043A? \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C,
      \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846215
    m_Localized: "\u041F\u0440\u0438 \u043E\u0431\u0433\u043E\u043D\u0435 \u0434\u0432\u0438\u0436\u0443\u0449\u0435\u0433\u043E\u0441\u044F
      \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u043E\u0433\u043E
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0437\u0430\u043D\u0438\u043C\u0430\u0439\u0442\u0435 \u0442\u0430\u043A\u043E\u0435
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u043C\u043E\u0433 \u0432\u0430\u0441
      \u0432\u0438\u0434\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846214
    m_Localized: "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439, \u044D\u0442\u043E\u0442
      \u043F\u0430\u0440\u0435\u043D\u044C, \u0432\u043C\u0435\u0441\u0442\u043E
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C
      \u0432 \u0437\u0430\u0434\u043D\u044E\u044E \u0447\u0430\u0441\u0442\u044C
      \u043C\u0430\u0448\u0438\u043D\u044B, \u043F\u043E\u0447\u0435\u043C\u0443
      \u0431\u044B \u0442\u0435\u0431\u0435 \u043D\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u0441\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u044F \u0432\u0438\u0434\u0435\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846213
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846212
    m_Localized: "\u0412\u043E\u0442 \u043F\u043E\u0447\u0435\u043C\u0443 \u043C\u044B
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u044B
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u0432 \u0441\u043B\u0435\u043F\u043E\u0439
      \u0437\u043E\u043D\u0435 \u043E\u0431\u0437\u043E\u0440\u0430 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846211
    m_Localized: "\u0415\u0441\u043B\u0438 \u0431\u044B \u043C\u0430\u0448\u0438\u043D\u0430
      \u043F\u0440\u043E\u0435\u0445\u0430\u043B\u0430 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0434\u0430\u043B\u044C\u0448\u0435, \u043C\u044B \u0431\u044B \u0447\u0443\u0442\u044C
      \u043D\u0435 \u0440\u0430\u0437\u0431\u0438\u043B\u0438\u0441\u044C! \u0420\u0430\u0437\u0432\u0435
      \u044D\u0442\u043E \u043D\u0435 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846210
    m_Localized: "\u041C\u0430\u0448\u0438\u043D\u0430 \u0437\u0430\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442
      \u043C\u0435\u0441\u0442\u043E\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u043C\u043E\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443
      \u0435\u0433\u043E \u0432\u0438\u0434\u0435\u0442\u044C \u0438\u0437\u043D\u0443\u0442\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846209
    m_Localized: "\u041C\u044B \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C \u0442\u0430\u043A\u0438\u0435
      \u043C\u0435\u0441\u0442\u0430 \xAB\u0441\u043B\u0435\u043F\u044B\u043C\u0438
      \u0437\u043E\u043D\u0430\u043C\u0438\xBB. \u0412\u043E\u0442 \u043F\u043E\u0447\u0435\u043C\u0443
      \u043D\u0430\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0431\u044B\u0442\u044C
      \u0432 \u0442\u0430\u043A\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445
      \u0431\u043E\u043B\u0435\u0435 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4232906846208
    m_Localized: "\u0422\u043E \u0436\u0435 \u0441\u0430\u043C\u043E\u0435 \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
      \u043B\u044E\u0434\u0435\u0439 \u0432 \u043C\u0430\u0448\u0438\u043D\u0430\u0445.
      \u0412\u0430\u0441 \u0442\u043E\u0436\u0435 \u043C\u043E\u0433\u0443\u0442
      \u043D\u0435 \u0443\u0432\u0438\u0434\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651936
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0441\u044E\u0434\u0430, \u0440\u0430\u0437\u0432\u0435 \u0432\u044B \u043D\u0435
      \u0432\u0438\u0434\u0438\u0442\u0435 \u043B\u0438\u0446\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0432\u043D\u0443\u0442\u0440\u0438 \u043C\u0430\u0448\u0438\u043D\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651935
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443, \u0435\u0441\u043B\u0438
      \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C \u043D\u0430\u0447\u043D\u0435\u0442
      \u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u0438\u043B\u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F,
      \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651934
    m_Localized: "\u041D\u0430 \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435,
      \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u043C\u043E\u0433 \u0432\u0430\u0441
      \u0442\u0430\u043C \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651933
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0432\u044B\u044F\u0441\u043D\u0438\u043C, \u043F\u043E\u0447\u0435\u043C\u0443
      \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u043F\u0430\u0441\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651932
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E!
      \u0412\u044B \u043C\u043E\u0433\u043B\u0438 \u044D\u0442\u043E\u0433\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651931
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438! \u0415\u0441\u043B\u0438
      \u0442\u044B \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0435\u0448\u044C,
      \u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651930
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u043D\u0430\u043B\u0435\u0432\u043E \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651929
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651928
    m_Localized: "\u041E\u0433\u043E! \u042F \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u0434\u0438\u0432\u043B\u0435\u043D! \u041C\u0430\u0448\u0438\u043D\u044B
      \u043C\u043E\u0433\u0443\u0442 \u0435\u0445\u0430\u0442\u044C \u0434\u0430\u0436\u0435
      \u043D\u0430 \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u0441\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651927
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438, \u044D\u0442\u043E\u0442
      \u043F\u0430\u0440\u0435\u043D\u044C \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0443\u043B\u0438\u0446\u0443, \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0430\u0433\u043E\u0440\u0430\u0435\u0442\u0441\u044F \u0437\u0435\u043B\u0435\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651926
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u0435\u0440\u0435\u0434
      \u0442\u0435\u043C, \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443, \u0432\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C,
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C \u043B\u0438
      \u043C\u0430\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651925
    m_Localized: "\u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u0441\u0438\u0433\u043D\u0430\u043B
      \u0441\u0432\u0435\u0442\u043E\u0444\u043E\u0440\u0430 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F,
      \u0441\u0431\u043E\u043A\u0443 \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u044F\u0432\u0438\u0442\u044C\u0441\u044F
      \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651924
    m_Localized: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0438
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442 \u0441\u0438\u0433\u043D\u0430\u043B
      \u0438 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u044E\u0442
      \u043C\u0438\u043C\u043E, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430\u043C
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651923
    m_Localized: "\u0420\u0430\u043D\u044C\u0448\u0435, \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0430\u0433\u043E\u0440\u0430\u043B\u0441\u044F \u0437\u0435\u043B\u0435\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442, \u0432\u044B \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0443,
      \u043D\u0435 \u0433\u043B\u044F\u0434\u044F \u043D\u0438 \u043D\u0430 \u0447\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651922
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u0435\u0440\u043D\u0435\u043C\u0441\u044F
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651921
    m_Localized: "\u041D\u0443 \u043A\u0430\u043A? \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C,
      \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651920
    m_Localized: "\u0422\u043E\u0433\u0434\u0430 \u043B\u044E\u0434\u0438 \u0432
      \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F\u0445 \u0441\u043C\u043E\u0433\u0443\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u0430\u0441 \u0443\u0437\u043D\u0430\u0442\u044C
      \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u0443\u043B\u0438\u0446\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651919
    m_Localized: "\u0420\u0430\u0437\u0432\u0435 \u044D\u0442\u043E\u0442 \u043F\u0430\u0440\u0435\u043D\u044C
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651918
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651917
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u0442\u0435
      \u0440\u0443\u043A\u0443, \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u043C\u043E\u0436\u0435\u0442 \u0432\u0430\u0441 \u043D\u0435 \u0443\u0432\u0438\u0434\u0435\u0442\u044C,
      \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651916
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435, \u043E\u043D
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443, \u0434\u0430\u0436\u0435 \u043D\u0435
      \u043F\u043E\u0434\u043D\u044F\u0432 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651915
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430\u043C \u043B\u0443\u0447\u0448\u0435
      \u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u0440\u0443\u043A\u0438 \u0438 \u0434\u0430\u0442\u044C \u0438\u043C \u0437\u043D\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651914
    m_Localized: "\u0423 \u043B\u044E\u0434\u0435\u0439 \u0432 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044F\u0445
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0442
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0441 \u043E\u0431\u0437\u043E\u0440\u043E\u043C
      \u0432\u043F\u0435\u0440\u0435\u0434 \u0438\u043B\u0438 \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651913
    m_Localized: "\u041D\u0443, \u0442\u043E\u0433\u0434\u0430 \u0432\u0430\u043C
      \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0431\u044B\u0442\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u043C\u0438,
      \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651912
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u0442\u0435
      \u0440\u0443\u043A\u0443, \u043B\u044E\u0434\u0438 \u0432 \u043C\u0430\u0448\u0438\u043D\u0435
      \u043C\u043E\u0433\u0443\u0442 \u0432\u0430\u0441 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C,
      \u0438 \u043C\u0430\u0448\u0438\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u043E\u0435\u0434\u0435\u0442 \u043C\u0438\u043C\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651911
    m_Localized: "\u0422\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0448\u0451\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435, \u043D\u0435 \u0442\u0430\u043A \u043B\u0438?
      \u0422\u044B \u0434\u0430\u0436\u0435 \u0440\u0443\u043A\u0443 \u043D\u0435
      \u043F\u043E\u0434\u043D\u044F\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651910
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043C\u0441\u044F,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u0434\u0448\u0435\u0435
      \u0431\u044B\u043B\u043E \u043E\u043F\u0430\u0441\u043D\u044B\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651909
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u043C\u043E\u0436\u0435\u0442 \u043E\u0448\u0438\u0431\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651908
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u0435\u0440\u043D\u0435\u043C\u0441\u044F
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651907
    m_Localized: "\u041D\u0443 \u043A\u0430\u043A? \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C,
      \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651906
    m_Localized: "\u0412\u0441\u0435\u0433\u0434\u0430 \u043F\u043E\u043C\u043D\u0438\u0442\u0435,
      \u0447\u0442\u043E \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435
      \u0441\u0438\u0433\u043D\u0430\u043B\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432\u0430\u0448\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651905
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0437\u0430\u0433\u043E\u0440\u0438\u0442\u0441\u044F
      \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u0441\u0432\u0435\u0442, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u043D\u0430\u043B\u0435\u0432\u043E \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043E,
      \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u0440\u0443\u043A\u0443
      \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4232902651904
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0437\u0430\u0433\u043E\u0440\u0430\u0435\u0442\u0441\u044F
      \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0441\u0432\u0435\u0442, \u0432\u044B
      \u0434\u043E\u043B\u0436\u043D\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0436\u0435\u043B\u0442\u043E\u0439 \u043B\u0438\u043D\u0438\u0435\u0439
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438, \u0432\u043E\u0442
      \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457628
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E, \u043D\u0430 \u044D\u0442\u043E\u0442
      \u0440\u0430\u0437 \u044F \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u043F\u043E\u043A\u0430\u0436\u0443 \u0432\u0430\u043C, \u043A\u0430\u043A
      \u0431\u044B\u0442\u044C \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457627
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435
      \u0443\u043B\u0438\u0446\u044B \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0441\u0438\u0433\u043D\u0430\u043B\u0430\u043C
      \u0441\u0432\u0435\u0442\u043E\u0444\u043E\u0440\u0430 \u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E
      \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457626
    m_Localized: "\u041D\u043E \u0435\u0441\u043B\u0438 \u043C\u044B \u043D\u0435
      \u0431\u0443\u0434\u0435\u043C \u043E\u0431 \u044D\u0442\u043E\u043C \u043F\u043E\u043C\u043D\u0438\u0442\u044C,
      \u044D\u0442\u043E \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043E\u043F\u0430\u0441\u043D\u043E, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u043D\u0438 \u043C\u0430\u0448\u0438\u043D\u0430, \u043D\u0438
      \u044F \u043D\u0435 \u0431\u0443\u0434\u0435\u043C \u0437\u043D\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457625
    m_Localized: "\u0421\u0432\u0435\u0442\u043E\u0444\u043E\u0440\u044B \u0438 \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043D\u044B\u0435
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B \u043F\u0440\u0438\u0437\u0432\u0430\u043D\u044B
      \u043F\u043E\u043C\u043E\u0447\u044C \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C
      \u0437\u043D\u0430\u0442\u044C, \u043A\u043E\u0433\u0434\u0430 \u0438 \u0433\u0434\u0435
      \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457624
    m_Localized: "\u0421\u0435\u0440\u044C\u0451\u0437\u043D\u043E, \u044D\u0442\u043E
      \u043C\u043E\u0436\u0435\u0442 \u0432 \u043E\u0434\u043D\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u043A \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E\u0439
      \u0430\u0432\u0430\u0440\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457623
    m_Localized: "\u0412 \u0442\u0430\u043A\u0438\u0435 \u043C\u043E\u043C\u0435\u043D\u0442\u044B
      \u043C\u0430\u0448\u0438\u043D\u0430 \u0432\u0430\u0441 \u043D\u0435 \u0432\u0438\u0434\u0438\u0442,
      \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0435\u0439 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457622
    m_Localized: "\u0412\u044B \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E,
      \u043F\u0435\u0440\u0435\u0448\u043B\u0438 \u0443\u043B\u0438\u0446\u0443 \u043D\u0430
      \u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u0441\u0432\u0435\u0442? \u0418\u043B\u0438
      \u0432\u044B \u0432\u044B\u0448\u043B\u0438 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u044D\u0442\u043E \u0431\u044B\u043B \u043D\u0435
      \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0445\u043E\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457621
    m_Localized: "\u0417\u0430\u0447\u0435\u043C \u0442\u044B \u0441\u0434\u0435\u043B\u0430\u043B
      \u0447\u0442\u043E-\u0442\u043E \u0441\u0442\u043E\u043B\u044C \u043E\u043F\u0430\u0441\u043D\u043E\u0435?
      \u0414\u0430\u0436\u0435 \u0432 \u0448\u0443\u0442\u043A\u0443, \u0442\u044B
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0438\u0447\u0435\u0433\u043E \u043F\u043E\u0434\u043E\u0431\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457620
    m_Localized: "\u0412\u043E\u0442 \u044D\u0442\u043E \u0431\u044B\u043B\u043E\u2026
      \u0442\u043E, \u0447\u0435\u0433\u043E \u043C\u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0435 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457619
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u0435\u0440\u043D\u0435\u043C\u0441\u044F
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457618
    m_Localized: "\u041D\u0443 \u043A\u0430\u043A? \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C,
      \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457617
    m_Localized: "\u042F \u0443\u0432\u0435\u0440\u0435\u043D, \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C
      \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C. \u042F \u0432\u0435\u0440\u044E
      \u0432 \u0442\u0435\u0431\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457616
    m_Localized: "\u042D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E! \u041A\u043E\u0433\u0434\u0430 \u0432\u044B
      \u0438\u0434\u0435\u0442\u0435 \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0434\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430, \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457615
    m_Localized: "\u0425\u043E\u0440\u043E\u0448\u043E, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u043A\u0430\u043A
      \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457614
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u043E\u0442\u043E\u043A \u0437\u0430\u043F\u0443\u0442\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C,
      \u044D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043E\u043F\u0430\u0441\u043D\u043E \u043A\u0430\u043A \u0434\u043B\u044F
      \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0435\u0439, \u0442\u0430\u043A
      \u0438 \u0434\u043B\u044F \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457613
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u0440\u0435\u0437\u043A\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C, \u043A\u0430\u043A
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E, \u043B\u044E\u0434\u0438
      \u043F\u043E\u0437\u0430\u0434\u0438 \u0432\u0430\u0441 \u043C\u043E\u0433\u0443\u0442
      \u0431\u044B\u0442\u044C \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u044B \u0438
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0442\u0440\u0430\u0432\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457612
    m_Localized: "\u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0441\u0430\u043C\u043E\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0435
      \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u0438\u0434\u0442\u0438, \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457611
    m_Localized: "\u0415\u0441\u043B\u0438 \u043F\u043E\u0442\u043E\u043A \u0437\u0430\u043F\u0443\u0442\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C,
      \u043C\u043E\u0436\u0435\u0442 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u0443\u0442\u044C
      \u0431\u043E\u043B\u0435\u0435 \u043E\u043F\u0430\u0441\u043D\u0430\u044F \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457610
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C,
      \u043C\u0430\u0448\u0438\u043D\u0430 \u0438 \u043B\u044E\u0434\u0438, \u0438\u0434\u0443\u0449\u0438\u0435
      \u0437\u0430 \u0432\u0430\u043C\u0438, \u043C\u043E\u0433\u0443\u0442 \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u0442\u044C\u0441\u044F
      \u0438 \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C: \xAB\u0410? \u041F\u043E\u0447\u0435\u043C\u0443
      \u0432\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457609
    m_Localized: "\u041C\u0430\u0448\u0438\u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430,
      \u0447\u0442\u043E \u0432\u044B \u043F\u043E\u0439\u0434\u0435\u0442\u0435
      \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457608
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043E\u043F\u0430\u0441\u043D\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u0442\u043E\u044F\u0442\u044C \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457607
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u0440\u0435\u0437\u043A\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C, \u0432\u043E\u043A\u0440\u0443\u0433
      \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0447\u0430\u0442\u044C\u0441\u044F
      \u0445\u0430\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457606
    m_Localized: "\u0412\u0441\u0435 \u0436\u0434\u0430\u043B\u0438, \u043A\u043E\u0433\u0434\u0430
      \u0442\u044B \u043F\u043E\u0439\u0434\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457605
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0432\u044B
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u043B\u0438 \u0443\u043B\u0438\u0446\u0443
      \u0438 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0434\u043E\u0440\u043E\u0433\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457604
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043C\u0441\u044F,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u0434\u0448\u0435\u0435
      \u0431\u044B\u043B\u043E \u043E\u043F\u0430\u0441\u043D\u044B\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457603
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u043C\u043E\u0436\u0435\u0442 \u043E\u0448\u0438\u0431\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457602
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u0435\u0440\u043D\u0435\u043C\u0441\u044F
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457601
    m_Localized: "\u041D\u0443 \u043A\u0430\u043A? \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C,
      \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232898457600
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043F\u043E\u0434\u043E\u0436\u0434\u0435\u0442\u0435
      \u0432\u043E\u0442 \u0442\u0430\u043A, \u0430 \u0437\u0430\u0442\u0435\u043C
      \u043F\u0435\u0440\u0435\u0439\u0434\u0435\u0442\u0435 \u0434\u043E\u0440\u043E\u0433\u0443,
      \u0432\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u0435\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263318
    m_Localized: "\u0412\u0438\u0434\u0438\u0442\u0435 \u043B\u0438 \u0432\u044B
      \u044D\u0442\u043E\u0433\u043E \u043F\u0430\u0440\u043D\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u043C\u0438\u0433\u0430\u0435\u0442 \u0441\u0432\u0435\u0442,
      \u0438 \u0436\u0434\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0441\u0438\u0433\u043D\u0430\u043B\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263317
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0435\u043B\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263316
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043D\u0435 \u0431\u0443\u0434\u0435\u0442\u0435
      \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u043C,
      \u0442\u043E \u0442\u0430\u043A\u0430\u044F \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F
      \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442\u044C!
      \u041F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u0438\u0445 \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C! \u042D\u0442\u043E
      \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      \u0431\u044B\u0442\u044C \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443
      \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263315
    m_Localized: "\u0410\u0445! \u042F \u0442\u0430\u043A \u0438 \u0437\u043D\u0430\u043B!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263314
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438, \u043E\u043D \u0441\u0435\u0439\u0447\u0430\u0441
      \u043C\u0438\u0433\u0430\u0435\u0442, \u043D\u043E \u0435\u0441\u043B\u0438
      \u0442\u044B \u043F\u0440\u043E\u0441\u0442\u043E \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u0448\u044C..."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263313
    m_Localized: "\u0415\u0441\u043B\u0438 \u0432\u044B \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0432 \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F,
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0432\u0448\u0438\u043C\u0441\u044F
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0438\u043B\u0438 \u043D\u0430 \u0432\u0430\u0441 \u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u0442\u044C \u043C\u0430\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263312
    m_Localized: "\u0415\u0441\u043B\u0438 \u043C\u0438\u0433\u0430\u0435\u0442 \u0437\u0435\u043B\u0435\u043D\u044B\u0439
      \u0441\u0432\u0435\u0442, \u0437\u043D\u0430\u0447\u0438\u0442, \u0441\u043A\u043E\u0440\u043E
      \u043E\u043D \u0441\u0442\u0430\u043D\u0435\u0442 \u043A\u0440\u0430\u0441\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263311
    m_Localized: "\u0412 \u044D\u0442\u043E\u0442 \u043C\u043E\u043C\u0435\u043D\u0442
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043E\u043F\u0430\u0441\u043D\u043E,
      \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443 \u044D\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0441\u0438\u0433\u043D\u0430\u043B \u0441\u0432\u0435\u0442\u043E\u0444\u043E\u0440\u0430
      \u0441\u043A\u043E\u0440\u043E \u0441\u043C\u0435\u043D\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263310
    m_Localized: "\u0412\u044B \u043D\u0430\u0447\u0430\u043B\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443, \u043A\u043E\u0433\u0434\u0430 \u0437\u0430\u043C\u0438\u0433\u0430\u043B
      \u0437\u0435\u043B\u0435\u043D\u044B\u0439 \u0441\u0432\u0435\u0442, \u0432\u0435\u0440\u043D\u043E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263309
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043C\u0441\u044F,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u0434\u0448\u0435\u0435
      \u0431\u044B\u043B\u043E \u043E\u043F\u0430\u0441\u043D\u044B\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263308
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u043C\u043E\u0436\u0435\u0442 \u043E\u0448\u0438\u0431\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263307
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u0435\u0440\u043D\u0435\u043C\u0441\u044F
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0435\u0449\u0435 \u0440\u0430\u0437!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263306
    m_Localized: "\u041D\u0443 \u043A\u0430\u043A? \u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C,
      \u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263305
    m_Localized: "\u0422\u0430\u043A \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u0441\u043C\u043E\u0436\u0435\u0442 \u0432\u0430\u0441 \u043B\u0443\u0447\u0448\u0435
      \u0432\u0438\u0434\u0435\u0442\u044C, \u0430 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u044D\u0442\u043E \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263304
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438, \u044D\u0442\u043E\u0442
      \u043F\u0430\u0440\u0435\u043D\u044C \u0436\u0434\u0435\u0442 \u043F\u0440\u044F\u043C\u043E
      \u0437\u0430 \u0436\u0435\u043B\u0442\u043E\u0439 \u043B\u0438\u043D\u0438\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263303
    m_Localized: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u0434\u0430\u0432\u0430\u0439\u0442\u0435
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u043A\u0430\u043A
      \u043E\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u0438\u0442\u044C \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263302
    m_Localized: "\u0415\u0441\u043B\u0438 \u043C\u0430\u0448\u0438\u043D\u0430 \u043F\u043E\u0434\u044A\u0435\u0434\u0435\u0442,
      \u043E\u043D\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043C\u043E\u0436\u0435\u0442 \u0432\u0430\u0441 \u0441\u0431\u0438\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263301
    m_Localized: "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435, \u0435\u0441\u043B\u0438
      \u0432\u044B \u0437\u0430\u0439\u0434\u0435\u0442\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u0430\u043B\u0435\u043A\u043E \u0432\u043F\u0435\u0440\u0435\u0434\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263300
    m_Localized: "\u0410 \u0435\u0441\u043B\u0438 \u0432\u044B \u043F\u0440\u043E\u0435\u0434\u0435\u0442\u0435
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E
      \u0432\u043F\u0435\u0440\u0435\u0434, \u0432\u044B \u0440\u0438\u0441\u043A\u0443\u0435\u0442\u0435
      \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C\u0441\u044F \u0441 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263299
    m_Localized: "\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
      \u043B\u0438\u043D\u0438\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C
      \u043B\u0435\u0433\u0447\u0435 \u043D\u0430\u0441 \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263298
    m_Localized: "\u042D\u0442\u0430 \u043B\u0438\u043D\u0438\u044F \u2014 \u0437\u043D\u0430\u043A
      \xAB\u0441\u0442\u043E\u043F\xBB. \u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u0435\u0435 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
      \u043A \u043E\u0447\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0430\u0432\u0430\u0440\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263297
    m_Localized: "\u041F\u0440\u0438\u0447\u0438\u043D\u0430, \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0432\u0430\u0448\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0431\u044B\u043B\u0438
      \u043E\u043F\u0430\u0441\u043D\u044B\u043C\u0438, \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u043B\u0430\u0441\u044C
      \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0432\u044B \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u043B\u0438
      \u0436\u0435\u043B\u0442\u0443\u044E \u043B\u0438\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 4232894263296
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0440\u0430\u0437\u0431\u0435\u0440\u0435\u043C\u0441\u044F, \u043F\u043E\u0447\u0435\u043C\u0443
      \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u0435\u0434\u0448\u0435\u0435 \u0431\u044B\u043B\u043E
      \u043E\u043F\u0430\u0441\u043D\u044B\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807296
    m_Localized: "\u0423\u0447\u0435\u0431\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 28671530807297
